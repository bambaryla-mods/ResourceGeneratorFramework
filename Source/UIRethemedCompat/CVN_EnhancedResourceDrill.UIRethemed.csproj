<Project Sdk="Microsoft.NET.Sdk">

    <!-- Optional look for the drill tab, drawn with [LFS] UI Rethemed - Core. Compiled against its DLL and loaded only
         when that mod is active (LoadFolders IfModActive), so the framework never depends on it.
         Building this also builds CVN_EnhancedResourceDrill.csproj. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AssemblyName>CVN_EnhancedResourceDrill.UIRethemed</AssemblyName>
        <RootNamespace>CVN_EnhancedResourceDrill.UIRethemed</RootNamespace>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <OutputPath>..\..\Compat\UIRethemed\1.7\Assemblies\</OutputPath>
        <GameDir>..\..\..\..\</GameDir>
        <!-- [LFS] UI Rethemed - Core, Steam Workshop 3832843406. Override with -p:LfsCoreDir=... for a local copy. -->
        <LfsCoreDir Condition="'$(LfsCoreDir)' == ''">$(GameDir)..\..\workshop\content\294100\3832843406\</LfsCoreDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CVN_EnhancedResourceDrill.csproj" Private="false" />
        <Reference Include="UIRethemedCore">
            <HintPath>$(LfsCoreDir)Versions\1.7\Assemblies\UIRethemedCore.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(GameDir)..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GameDir)Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityStubs">
            <HintPath>$(GameDir)UnityStubs.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

</Project>
